{$MRI_DOMAIN} {
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
    }
    # No file_server, raw mount, image URLs, basic-auth-only fallback, or token in path/query.
    reverse_proxy mri:8000 {
        flush_interval -1
    }
}
