# Copy to .env (git-ignored) or set as system environment variables. Never commit real values.

# --- Google Drive (drive.readonly, root folder only) ---
KNEE_ROOT_FOLDER_ID=
# Option A: OAuth user token (run `python -m knee_mcp.google_login` once)
GOOGLE_CLIENT_SECRETS=C:\secure\knee-mcp\client_secret.json
GOOGLE_TOKEN_FILE=C:\secure\knee-mcp\google-token.json
# Option B: service account (share the root folder with it as Viewer)
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\secure\knee-mcp\service-account.json

# --- Cache (contains raw images with PII: keep on an encrypted/private disk) ---
KNEE_CACHE_DIR=C:\secure\knee-mcp\cache

# --- HTTP / auth ---
KNEE_HOST=127.0.0.1
KNEE_PORT=8765
KNEE_PUBLIC_URL=https://knee.example.com
# Static tokens for Claude Code / Inspector (generate: python -m knee_mcp --gen-token)
KNEE_BEARER_TOKENS=
# Enables the built-in OAuth login used by claude.ai connectors
KNEE_OWNER_PASSWORD=
# KNEE_ALLOWED_HOSTS=knee.example.com
# KNEE_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# --- OCR / redaction ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
KNEE_OCR_LANGS=eng+chi_tra
# Optional extra safety net: exact strings that must never appear after masking (name, chart no., DOB)
# KNEE_PII_TERMS=
KNEE_STUDY_TYPES=2018-12-31=X-ray,2019-03-20=MRI,2024-12-03=MRI
